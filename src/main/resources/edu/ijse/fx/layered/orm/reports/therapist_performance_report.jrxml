<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="therapist_performance_report"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <!-- Parameters -->
    <parameter name="fromDate"       class="java.lang.String"/>
    <parameter name="toDate"         class="java.lang.String"/>
    <parameter name="generatedBy"    class="java.lang.String">
        <defaultValueExpression><![CDATA["Admin"]]></defaultValueExpression>
    </parameter>
    <parameter name="totalSessions"  class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>
    <parameter name="completedCount" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>
    <parameter name="cancelledCount" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>
    <parameter name="avgPerformance" class="java.lang.String">
        <defaultValueExpression><![CDATA["0.0%"]]></defaultValueExpression>
    </parameter>

    <!-- Fields from AdminReportDTO -->
    <field name="therapistId"        class="java.lang.String"/>
    <field name="therapistName"      class="java.lang.String"/>
    <field name="totalSessions"      class="java.lang.Integer"/>
    <field name="completedSessions"  class="java.lang.Integer"/>
    <field name="cancelledSessions"  class="java.lang.Integer"/>
    <field name="performancePercent" class="java.lang.Double"/>

    <!-- Variables -->
    <variable name="rowNumber" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{therapistId}]]></variableExpression>
    </variable>

    <!-- ═══════════════ TITLE ═══════════════ -->
    <title>
        <band height="120" splitType="Stretch">

            <!-- Header background -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="90" backcolor="#1e3a5f" forecolor="#1e3a5f"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Accent bar -->
            <rectangle>
                <reportElement x="0" y="90" width="535" height="5" backcolor="#3b82f6" forecolor="#3b82f6"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <!-- Title text -->
            <staticText>
                <reportElement x="15" y="10" width="505" height="32" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Mental Health Therapy Center]]></text>
            </staticText>

            <staticText>
                <reportElement x="15" y="42" width="350" height="18" forecolor="#93c5fd" />
                <textElement textAlignment="Left">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <text><![CDATA[Therapist Performance & Session Statistics Report]]></text>
            </staticText>

            <!-- Date range on right -->
            <textField>
                <reportElement x="350" y="30" width="185" height="16" forecolor="#cbd5e1" />
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + ($P{fromDate} != null ? $P{fromDate} : "All") + "  →  " + ($P{toDate} != null ? $P{toDate} : "All")]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="350" y="48" width="185" height="16" forecolor="#cbd5e1" />
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{generatedBy}]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="350" y="64" width="185" height="16" forecolor="#cbd5e1" />
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy  HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- Summary row label -->
            <staticText>
                <reportElement x="0" y="100" width="535" height="18" />
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[SUMMARY OVERVIEW]]></text>
            </staticText>
        </band>
    </title>

    <!-- ═══════════════ PAGE HEADER (Summary Cards) ═══════════════ -->
    <pageHeader>
        <band height="70" splitType="Stretch">

            <!-- Card 1: Total -->
            <rectangle>
                <reportElement x="0" y="5" width="125" height="55" backcolor="#eff6ff" forecolor="#bfdbfe" />
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="10" width="125" height="14" forecolor="#64748b"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[TOTAL SESSIONS]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="125" height="28" forecolor="#2563eb"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="22" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{totalSessions}]]></textFieldExpression>
            </textField>

            <!-- Card 2: Completed -->
            <rectangle>
                <reportElement x="137" y="5" width="125" height="55" backcolor="#f0fdf4" forecolor="#bbf7d0" />
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="137" y="10" width="125" height="14" forecolor="#64748b"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[COMPLETED]]></text>
            </staticText>
            <textField>
                <reportElement x="137" y="26" width="125" height="28" forecolor="#16a34a"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="22" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{completedCount}]]></textFieldExpression>
            </textField>

            <!-- Card 3: Cancelled -->
            <rectangle>
                <reportElement x="274" y="5" width="125" height="55" backcolor="#fef2f2" forecolor="#fecaca" />
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="274" y="10" width="125" height="14" forecolor="#64748b"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[CANCELLED]]></text>
            </staticText>
            <textField>
                <reportElement x="274" y="26" width="125" height="28" forecolor="#dc2626"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="22" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{cancelledCount}]]></textFieldExpression>
            </textField>

            <!-- Card 4: Avg Performance -->
            <rectangle>
                <reportElement x="411" y="5" width="124" height="55" backcolor="#fffbeb" forecolor="#fde68a" />
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="411" y="10" width="124" height="14" forecolor="#64748b"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[AVG PERFORMANCE]]></text>
            </staticText>
            <textField>
                <reportElement x="411" y="26" width="124" height="28" forecolor="#d97706"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{avgPerformance}]]></textFieldExpression>
            </textField>

        </band>
    </pageHeader>

    <!-- ═══════════════ COLUMN HEADER ═══════════════ -->
    <columnHeader>
        <band height="28" splitType="Stretch">

            <rectangle>
                <reportElement x="0" y="0" width="535" height="28" backcolor="#1e3a5f" forecolor="#1e3a5f"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="5"   y="0" width="20"  height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="25"  y="0" width="65"  height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[THERAPIST ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="90"  y="0" width="140" height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[THERAPIST NAME]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="0" width="65"  height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <staticText>
                <reportElement x="295" y="0" width="70"  height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[COMPLETED]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="0" width="70"  height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[CANCELLED]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="100" height="28" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[PERFORMANCE %]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ═══════════════ DETAIL (rows) ═══════════════ -->
    <detail>
        <band height="28" splitType="Stretch">

            <!-- Alternating row background -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="27"
                               backcolor="#f8fafc" forecolor="#e2e8f0">
                    <printWhenExpression><![CDATA[$V{rowNumber} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>

            <!-- Row separator line -->
            <line>
                <reportElement x="0" y="27" width="535" height="1" forecolor="#e2e8f0"/>
            </line>

            <!-- Row number -->
            <textField>
                <reportElement x="5" y="0" width="20" height="27" forecolor="#94a3b8"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{rowNumber}]]></textFieldExpression>
            </textField>

            <!-- Therapist ID -->
            <textField>
                <reportElement x="25" y="0" width="65" height="27" forecolor="#3b82f6"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{therapistId}]]></textFieldExpression>
            </textField>

            <!-- Therapist Name -->
            <textField>
                <reportElement x="90" y="0" width="140" height="27" forecolor="#1e293b"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{therapistName}]]></textFieldExpression>
            </textField>

            <!-- Total Sessions -->
            <textField>
                <reportElement x="230" y="0" width="65" height="27" forecolor="#1e293b"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{totalSessions}]]></textFieldExpression>
            </textField>

            <!-- Completed -->
            <textField>
                <reportElement x="295" y="0" width="70" height="27" forecolor="#16a34a"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{completedSessions}]]></textFieldExpression>
            </textField>

            <!-- Cancelled -->
            <textField>
                <reportElement x="365" y="0" width="70" height="27" forecolor="#dc2626"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{cancelledSessions}]]></textFieldExpression>
            </textField>

            <!-- Performance % — green >= 80 -->
            <textField>
                <reportElement x="435" y="0" width="100" height="27" forecolor="#16a34a">
                    <printWhenExpression><![CDATA[$F{performancePercent} >= 80]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{performancePercent} + "%"]]></textFieldExpression>
            </textField>

            <!-- Performance % — amber >= 50 and < 80 -->
            <textField>
                <reportElement x="435" y="0" width="100" height="27" forecolor="#d97706">
                    <printWhenExpression><![CDATA[$F{performancePercent} >= 50 && $F{performancePercent} < 80]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{performancePercent} + "%"]]></textFieldExpression>
            </textField>

            <!-- Performance % — red < 50 -->
            <textField>
                <reportElement x="435" y="0" width="100" height="27" forecolor="#dc2626">
                    <printWhenExpression><![CDATA[$F{performancePercent} < 50]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{performancePercent} + "%"]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ═══════════════ PAGE FOOTER ═══════════════ -->
    <pageFooter>
        <band height="30" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#3b82f6"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="250" height="20" forecolor="#94a3b8"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Mental Health Therapy Center — Confidential]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="5" width="135" height="20" forecolor="#94a3b8"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="400" y="5" width="135" height="20" forecolor="#94a3b8"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ═══════════════ SUMMARY ═══════════════ -->
    <summary>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="5" width="535" height="30" backcolor="#eff6ff" forecolor="#bfdbfe"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="5" width="200" height="30" forecolor="#1e3a5f"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[— End of Report —]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="5" width="325" height="30" forecolor="#64748b"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[This report is auto-generated. For queries contact administration.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>