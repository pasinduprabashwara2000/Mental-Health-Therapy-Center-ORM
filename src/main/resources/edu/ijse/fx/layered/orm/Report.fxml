<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0" stylesheets="@css/report.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.AdminReportController">

    <children>

        <!-- Title -->
        <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Admin Reports Dashboard" />

        <!-- Filter Section -->
        <HBox layoutX="30.0" layoutY="70.0" spacing="15">

            <children>

                <VBox spacing="5">
                    <children>
                        <Label text="From Date" />
                        <DatePicker fx:id="txtFromDate" prefWidth="160" />
                    </children>
                </VBox>

                <VBox spacing="5">
                    <children>
                        <Label text="To Date" />
                        <DatePicker fx:id="txtToDate" prefWidth="160" />
                    </children>
                </VBox>

                <VBox spacing="5">
                    <children>
                        <Label text="Therapist" />
                        <ComboBox fx:id="cmbTherapist" prefWidth="180" />
                    </children>
                </VBox>

                <VBox spacing="5">
                    <children>
                        <Label text="Session Type" />
                        <ComboBox fx:id="cmbSessionType" prefWidth="180" />
                    </children>
                </VBox>

                <VBox alignment="BOTTOM_LEFT">
                    <children>
                        <Button fx:id="btnGenerate" mnemonicParsing="false" onAction="#btnGenerateOnAction" prefHeight="38" prefWidth="140" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" text="Generate Report" />
                    </children>
                </VBox>

            </children>

        </HBox>

        <!-- Charts Section -->
        <HBox layoutX="30.0" layoutY="150.0" spacing="25">

            <children>

                <!-- Therapist Performance Chart -->
                <VBox spacing="10">

                    <children>

                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Therapist Performance" />

                        <BarChart fx:id="barTherapistPerformance" prefHeight="320.0" prefWidth="540.0">

                            <xAxis>
                                <CategoryAxis label="Therapists" />
                            </xAxis>

                            <yAxis>
                                <NumberAxis label="Completed Sessions" />
                            </yAxis>

                        </BarChart>

                    </children>

                </VBox>

                <!-- Therapy Session Statistics -->
                <VBox spacing="10">

                    <children>

                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Therapy Session Statistics" />

                        <PieChart fx:id="pieSessionStats" prefHeight="320.0" prefWidth="500.0" />

                    </children>

                </VBox>

            </children>

        </HBox>

        <!-- Report Table -->
        <VBox layoutX="30.0" layoutY="523.0" spacing="10">

            <children>

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Detailed Report" />

                <TableView fx:id="tblReports" prefHeight="180.0" prefWidth="1120.0">

                    <columns>

                        <TableColumn fx:id="colTherapistId" prefWidth="120.0" text="Therapist ID" />

                        <TableColumn fx:id="colTherapistName" prefWidth="200.0" text="Therapist Name" />

                        <TableColumn fx:id="colSessionCount" prefWidth="160.0" text="Session Count" />

                        <TableColumn fx:id="colCompletedSessions" prefWidth="180.0" text="Completed Sessions" />

                        <TableColumn fx:id="colCancelledSessions" prefWidth="180.0" text="Cancelled Sessions" />

                        <TableColumn fx:id="colPerformance" prefWidth="160.0" text="Performance %" />

                    </columns>

                </TableView>

            </children>

        </VBox>

    </children>

</AnchorPane>
