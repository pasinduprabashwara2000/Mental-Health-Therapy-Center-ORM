<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0"
            style="-fx-background-color: white;"
            stylesheets="@css/style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.ijse.fx.layered.orm.controller.PatientsController">

    <children>

        <!-- Title -->
        <Label layoutX="25.0" layoutY="20.0"
               text="Manage Patients">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
        </Label>

        <!-- Patient Name -->
        <Label layoutX="25.0" layoutY="69.0"
               text="Patient Name :">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TextField fx:id="patientNameTxt"
                   layoutX="25.0" layoutY="116.0"
                   prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0"/>
            </font>
        </TextField>

        <!-- Age -->
        <Label layoutX="368.0" layoutY="69.0"
               text="Age :">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TextField fx:id="ageTxt"
                   layoutX="368.0" layoutY="115.0"
                   prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0"/>
            </font>
        </TextField>

        <!-- Gender -->
        <Label layoutX="710.0" layoutY="69.0"
               text="Gender :">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <ChoiceBox fx:id="genderChoiceBox"
                   layoutX="710.0"
                   layoutY="115.0"
                   prefHeight="41.0"
                   prefWidth="304.0"
                   styleClass="text-field"
                   stylesheets="@css/style.css"/>

        <!-- Contact Number -->
        <Label layoutX="25.0" layoutY="177.0"
               text="Contact Number :">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TextField fx:id="contactTxt"
                   layoutX="25.0" layoutY="228.0"
                   prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0"/>
            </font>
        </TextField>

        <!-- Address -->
        <Label layoutX="368.0" layoutY="177.0"
               text="Address :">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TextField fx:id="addressTxt"
                   layoutX="368.0" layoutY="228.0"
                   prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0"/>
            </font>
        </TextField>

        <!-- Disease -->
        <Label layoutX="710.0" layoutY="177.0"
               text="Disease :">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <TextField fx:id="diseaseTxt"
                   layoutX="710.0" layoutY="228.0"
                   prefHeight="41.0"
                   prefWidth="304.0">
            <font>
                <Font size="15.0"/>
            </font>
        </TextField>

        <!-- Buttons -->
        <Button fx:id="saveBtn"
                layoutX="25.0" layoutY="299.0"
                prefHeight="41.0" prefWidth="137.0"
                styleClass="button-save"
                stylesheets="@css/style.css"
                text="Save"/>

        <Button fx:id="updateBtn"
                layoutX="177.0" layoutY="299.0"
                prefHeight="41.0" prefWidth="137.0"
                styleClass="button-update"
                stylesheets="@css/style.css"
                text="Update"/>

        <Button fx:id="deleteBtn"
                layoutX="329.0" layoutY="299.0"
                prefHeight="41.0" prefWidth="137.0"
                styleClass="button-delete"
                stylesheets="@css/style.css"
                text="Delete"/>

        <Button fx:id="resetBtn"
                layoutX="483.0" layoutY="299.0"
                prefHeight="41.0" prefWidth="137.0"
                styleClass="button-reset"
                stylesheets="@css/style.css"
                text="Reset"/>

        <!-- Table -->
        <TableView fx:id="patientTable"
                   layoutX="25.0"
                   layoutY="367.0"
                   prefHeight="308.0"
                   prefWidth="1027.0"
                   styleClass="therapist-table">

            <columns>

                <TableColumn fx:id="colId"
                             prefWidth="120.0"
                             text="Patient ID"/>

                <TableColumn fx:id="colName"
                             prefWidth="220.0"
                             text="Patient Name"/>

                <TableColumn fx:id="colAge"
                             prefWidth="100.0"
                             text="Age"/>

                <TableColumn fx:id="colGender"
                             prefWidth="120.0"
                             text="Gender"/>

                <TableColumn fx:id="colContact"
                             prefWidth="160.0"
                             text="Contact Number"/>

                <TableColumn fx:id="colAddress"
                             prefWidth="160.0"
                             text="Address"/>

                <TableColumn fx:id="colDisease"
                             prefWidth="140.0"
                             text="Disease"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>