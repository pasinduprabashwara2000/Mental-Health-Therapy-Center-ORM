<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0" style="-fx-background-color: white;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.ProgramsController">
    <children>
        <Label layoutX="25.0" layoutY="20.0" prefHeight="31.0" prefWidth="401.0" text="Manage Programs">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <Label layoutX="25.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Program Name : ">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="programTxt" layoutX="25.0" layoutY="116.0" prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0" />
            </font></TextField>
        <Label layoutX="368.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Duration  : ">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="durationTxt" layoutX="368.0" layoutY="115.0" prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0" />
            </font></TextField>
        <Label layoutX="710.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Cost :">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="costTxt" layoutX="710.0" layoutY="116.0" prefHeight="41.0" prefWidth="304.0">
            <font>
                <Font size="15.0" />
            </font></TextField>
        <Button fx:id="saveBtn" layoutX="25.0" layoutY="299.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="137.0" styleClass="button-save" stylesheets="@css/style.css" text="Save" />
        <Button fx:id="updateBtn" layoutX="177.0" layoutY="299.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="137.0" styleClass="button-update" stylesheets="@css/style.css" text="Update" />
        <Button fx:id="deleteBtn" layoutX="329.0" layoutY="299.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="137.0" styleClass="button-delete" stylesheets="@css/style.css" text="Delete" />
        <Button fx:id="resetBtn" layoutX="483.0" layoutY="298.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="137.0" styleClass="button-reset" stylesheets="@css/style.css" text="Reset" />
        <TableView fx:id="therapistTable" layoutX="25.0" layoutY="367.0" prefHeight="308.0" prefWidth="1027.0" styleClass="therapist-table">
            <columns>
                <TableColumn prefWidth="149.0" text="Program ID" />
                <TableColumn prefWidth="240.0" text="Program Name" />
                <TableColumn prefWidth="183.0" text="Duration" />
                <TableColumn prefWidth="141.0" text="Cost" />
                <TableColumn prefWidth="612.0" text="Description" />
            </columns>
        </TableView>
      <Label layoutX="25.0" layoutY="177.0" prefHeight="41.0" prefWidth="278.0" text="Descriptions  : ">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="descriptionsTxt" layoutX="25.0" layoutY="228.0" prefHeight="41.0" prefWidth="304.0">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
    </children>
</AnchorPane>
