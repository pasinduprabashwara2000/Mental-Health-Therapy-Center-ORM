<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0" style="-fx-background-color: white;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.SessionController">
    <children>
        <Label layoutX="25.0" layoutY="20.0" prefHeight="31.0" prefWidth="401.0" text="Manage Sessions">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <Label layoutX="25.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Therapist ID : ">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="idTxt" managed="false" visible="false" />
        <Label layoutX="368.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Patient ID  : ">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label layoutX="710.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Date :">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Button fx:id="saveBtn" layoutX="25.0" layoutY="190.0" mnemonicParsing="false" onAction="#navigateSave" prefHeight="41.0" prefWidth="137.0" styleClass="button-save" stylesheets="@css/style.css" text="Save" />
        <Button fx:id="updateBtn" layoutX="177.0" layoutY="190.0" mnemonicParsing="false" onAction="#navigateUpdate" prefHeight="41.0" prefWidth="137.0" styleClass="button-update" stylesheets="@css/style.css" text="Update" />
        <Button fx:id="deleteBtn" layoutX="329.0" layoutY="190.0" mnemonicParsing="false" onAction="#navigateDelete" prefHeight="41.0" prefWidth="137.0" styleClass="button-delete" stylesheets="@css/style.css" text="Delete" />
        <Button fx:id="resetBtn" layoutX="483.0" layoutY="189.0" mnemonicParsing="false" onAction="#navigateReset" prefHeight="41.0" prefWidth="137.0" styleClass="button-reset" stylesheets="@css/style.css" text="Reset" />
        <TableView fx:id="sessionTable" layoutX="25.0" layoutY="258.0" prefHeight="417.0" prefWidth="1027.0" styleClass="therapist-table">
            <columns>
                <TableColumn fx:id="colSessionId" prefWidth="166.0" text="Session ID" />
                <TableColumn fx:id="colTherapistId" prefWidth="183.0" text="Therapist ID" />
                <TableColumn fx:id="colPatientId" prefWidth="182.0" text="Patient ID" />
                <TableColumn fx:id="colDate" prefWidth="1168.0" text="Date" />
            </columns>
        </TableView>
      <ComboBox fx:id="therapistIdPicker" layoutX="25.0" layoutY="117.0" prefHeight="41.0" prefWidth="288.0" promptText="Select Therapist ID" styleClass="choice-box" stylesheets="@css/style.css" />
      <ComboBox fx:id="patientIdPicker" layoutX="368.0" layoutY="117.0" prefHeight="41.0" prefWidth="288.0" promptText="Select Patient ID" styleClass="choice-box" stylesheets="@css/style.css" />
      <DatePicker fx:id="datePicker" layoutX="710.0" layoutY="118.0" prefHeight="39.0" prefWidth="288.0" stylesheets="@css/style.css" />
    </children>
</AnchorPane>
