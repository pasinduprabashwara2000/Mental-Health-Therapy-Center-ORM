<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0" style="-fx-background-color: #F4F6F9;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.DashboardController">
   <children>

      <!-- Main Content Area -->
      <AnchorPane prefHeight="700.0" prefWidth="1075.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" layoutX="-190.0" prefHeight="70.0" prefWidth="1025.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
               <children>
                  <Label text="Dashboard Overview" textFill="#333333">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="30.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>

            <!-- Cards Container (Metrics) -->
            <HBox layoutX="30.0" layoutY="100.0" prefHeight="135.0" prefWidth="775.0" spacing="25.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">
               <children>
                  <!-- Card 1 (Green - e.g., Active Users) -->
                  <AnchorPane prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #2ECC71; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Therapists" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="therapistsTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>

                  <!-- Card 2 (Blue - e.g., Operations) -->
                  <AnchorPane prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #3498DB; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Programs" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="programsTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>

                  <!-- Card 3 (Orange - e.g., Alerts) -->
                  <AnchorPane prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #E67E22; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Sessions" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="sessionsTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
                  <AnchorPane layoutX="540.0" layoutY="10.0" prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #eac94d; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Revenue" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="revenueTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
               </children>
            </HBox>

            <!-- Central Data Table (Recent Activity) -->
            <AnchorPane layoutX="30.0" layoutY="270.0" prefHeight="390.0" prefWidth="775.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="270.0">
               <children>
                  <Label layoutX="20.0" layoutY="15.0" text="Recent System Activity" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <TableView layoutX="20.0" layoutY="55.0" prefHeight="310.0" prefWidth="735.0" stylesheets="@css/style.css" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="55.0">
                     <columns>
                        <TableColumn prefWidth="120.0" text="ID" />
                        <TableColumn prefWidth="200.0" text="User / Entity" />
                        <TableColumn prefWidth="150.0" text="Action Status" />
                        <TableColumn prefWidth="240.0" text="Timestamp" />
                     </columns>
                  </TableView>
               </children>
            </AnchorPane>

         </children>
      </AnchorPane>
   </children>
</AnchorPane>
