<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0" style="-fx-background-color: #F4F6F9;" stylesheets="@css/dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.DashboardController">
   <children>

      <!-- Main Content Area -->
      <AnchorPane prefHeight="700.0" prefWidth="1075.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" layoutX="-190.0" prefHeight="70.0" prefWidth="1025.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
               <children>
                  <Label text="Dashboard Overview" textFill="#333333">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="30.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>

            <!-- Cards Container (Metrics) -->
            <HBox layoutX="30.0" layoutY="100.0" prefHeight="135.0" prefWidth="775.0" spacing="25.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0">
               <children>
                  <!-- Card 1 (Green) -->
                  <AnchorPane prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #2ECC71; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Therapists" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="therapistsTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                     </children>
                  </AnchorPane>

                  <!-- Card 2 (Blue) -->
                  <AnchorPane prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #3498DB; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Programs" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="programsTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                     </children>
                  </AnchorPane>

                  <!-- Card 3 (Orange) -->
                  <AnchorPane prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #E67E22; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Sessions" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="sessionsTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                     </children>
                  </AnchorPane>

                  <!-- Card 4 (Yellow) -->
                  <AnchorPane layoutX="540.0" layoutY="10.0" prefHeight="135.0" prefWidth="240.0" style="-fx-background-color: #eac94d; -fx-background-radius: 8px;">
                     <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Total Revenue" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="revenueTxt" layoutX="20.0" layoutY="55.0" text="--" textFill="WHITE">
                           <font><Font name="System Bold" size="32.0" /></font>
                        </Label>
                     </children>
                  </AnchorPane>
               </children>
            </HBox>

            <!-- Therapist Report Table -->
            <VBox layoutX="30.0" layoutY="260.0" prefHeight="224.0" prefWidth="1015.0" spacing="6" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),8,0,0,3); -fx-padding: 14;">
               <children>
                  <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1e293b;" text="Detailed Therapist Details" />
                  <TableView fx:id="tblReports" prefHeight="244.0" prefWidth="987.0" styleClass="dashboard-table" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colTherapistId" prefWidth="130" text="Therapist ID" />
                        <TableColumn fx:id="colTherapistName" prefWidth="360.0" text="Therapist Name" />
                        <TableColumn fx:id="colSessionCount" prefWidth="161.0" text="Total Sessions" />
                        <TableColumn fx:id="colCompletedSessions" prefWidth="179.0" text="Completed" />
                        <TableColumn fx:id="colCancelledSessions" prefWidth="153.0" text="Cancelled" />
                     </columns>
                     <placeholder>
                        <Label style="-fx-text-fill:#94a3b8;" text="No data available." />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
            <Label layoutX="38.0" layoutY="501.0" prefHeight="18.0" prefWidth="205.0" style="-fx-font-weight: bold;" text="Patient Therapy History">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>

         </children>
      </AnchorPane>
      <TableView fx:id="sessionTable" layoutX="35.0" layoutY="536.0" prefHeight="149.0" prefWidth="1015.0" styleClass="therapist-table">
         <columns>
            <TableColumn fx:id="colSID" prefWidth="150.0" text="Session ID" />
            <TableColumn fx:id="colTID" prefWidth="170.0" text="Therapist ID" />
            <TableColumn fx:id="colPID" prefWidth="170.0" text="Patient ID" />
            <TableColumn fx:id="colDate" prefWidth="160.0" text="Date" />
            <TableColumn fx:id="colTime" prefWidth="160.0" text="Time" />
            <TableColumn fx:id="colStatus" prefWidth="215.0" text="Status" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
