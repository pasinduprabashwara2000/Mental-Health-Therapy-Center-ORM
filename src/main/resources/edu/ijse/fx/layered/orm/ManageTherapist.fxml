<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1075.0" style="-fx-background-color: white;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.TherapistController">
   <children>
      <Label layoutX="25.0" layoutY="20.0" prefHeight="31.0" prefWidth="401.0" text="Manage Therapist">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="69.0" prefHeight="41.0" prefWidth="278.0" text="Therapist Name : ">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="idTxt" managed="false" visible="false" />
      <TextField fx:id="therapistTxt" layoutX="25.0" layoutY="116.0" prefHeight="41.0" prefWidth="304.0">
         <font>
            <Font size="15.0" />
         </font></TextField>
      <Label layoutX="710.0" layoutY="64.0" prefHeight="41.0" prefWidth="278.0" text=" Specialization  : ">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="specsTxt" layoutX="710.0" layoutY="110.0" prefHeight="41.0" prefWidth="304.0">
         <font>
            <Font size="15.0" />
         </font></TextField>
      <Label layoutX="25.0" layoutY="178.0" prefHeight="41.0" prefWidth="278.0" text="Contact Number  : ">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="contactTxt" layoutX="25.0" layoutY="225.0" prefHeight="41.0" prefWidth="304.0">
         <font>
            <Font size="15.0" />
         </font></TextField>
      <Button fx:id="saveBtn" layoutX="25.0" layoutY="295.0" mnemonicParsing="false" onAction="#navigateSave" prefHeight="41.0" prefWidth="137.0" styleClass="button-save" stylesheets="@css/style.css" text="Save" />
      <Button fx:id="updateBtn" layoutX="177.0" layoutY="295.0" mnemonicParsing="false" onAction="#navigateUpdate" prefHeight="41.0" prefWidth="137.0" styleClass="button-update" stylesheets="@css/style.css" text="Update" />
      <Button fx:id="deleteBtn" layoutX="329.0" layoutY="295.0" mnemonicParsing="false" onAction="#navigateDelete" prefHeight="41.0" prefWidth="137.0" styleClass="button-delete" stylesheets="@css/style.css" text="Delete" />
      <Button fx:id="resetBtn" layoutX="483.0" layoutY="294.0" mnemonicParsing="false" onAction="#navigateReset" prefHeight="41.0" prefWidth="137.0" styleClass="button-reset" stylesheets="@css/style.css" text="Reset" />
      <TableView fx:id="therapistTable" layoutX="25.0" layoutY="366.0" prefHeight="309.0" prefWidth="1027.0" styleClass="therapist-table">
        <columns>
            <TableColumn fx:id="colId" prefWidth="149.0" text="Therapist ID" />
            <TableColumn fx:id="colTherapistName" prefWidth="213.0" text="Therapist Name" />
           <TableColumn fx:id="colProgramId" prefWidth="119.0" text="Program ID" />
            <TableColumn fx:id="colSpecs" prefWidth="388.0" text="Specialization" />
            <TableColumn fx:id="colContact" prefWidth="456.0" text="Contact Number " />
        </columns>
      </TableView>
      <Label layoutX="369.0" layoutY="71.0" prefHeight="41.0" prefWidth="278.0" text="Program ID : ">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <ChoiceBox fx:id="programSelect" layoutX="369.0" layoutY="112.0" prefHeight="32.0" prefWidth="304.0" stylesheets="@css/style.css" />
   </children>
</AnchorPane>
