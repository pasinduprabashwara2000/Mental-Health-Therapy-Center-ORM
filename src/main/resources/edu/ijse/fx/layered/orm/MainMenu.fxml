      <Label alignment="CENTER" layoutX="393.0" layoutY="6.0" prefHeight="18.0" prefWidth="860.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Mental Health Therapy Center" textAlignment="CENTER" textFill="WHITE">
