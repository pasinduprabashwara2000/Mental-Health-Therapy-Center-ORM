<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.fx.layered.orm.controller.MainMenuController">
   <children>
      <AnchorPane prefHeight="768.0" prefWidth="291.0" styleClass="sidebar">
         <children>
            <Label alignment="CENTER" layoutY="27.0" prefHeight="29.0" prefWidth="291.0" style="-fx-text-fill: white;" text="Main Menu" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Button fx:id="therapitsBtn" layoutX="19.0" layoutY="134.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="253.0" styleClass="button-primary" stylesheets="@css/style.css" text="Manage Therapists">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            <Button fx:id="programsBtn" layoutX="19.0" layoutY="192.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="253.0" styleClass="button-primary" text="Manage Programs">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            <Button fx:id="logoutBtn" layoutX="19.0" layoutY="305.0" mnemonicParsing="false" onAction="#navigateLogout" prefHeight="36.0" prefWidth="253.0" styleClass="button-secondary" text="Log Out">
