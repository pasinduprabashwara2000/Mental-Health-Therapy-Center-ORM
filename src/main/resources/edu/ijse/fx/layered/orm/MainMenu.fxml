               </font>
            </Button>
            <Button fx:id="reportsBtn" layoutX="19.0" layoutY="250.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="253.0" styleClass="button-primary" text="View Reports">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane fx:id="contentPane" layoutX="291.0" layoutY="37.0" prefHeight="728.0" prefWidth="1075.0" styleClass="content-pane" stylesheets="@css/style.css" />
